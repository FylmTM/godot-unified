; The game's GDExtension: the drift sim + unified (godot, view, netcode, devui), built from
; simulation/extension into the hidden artifacts folder (git-ignored). Without it the game shows a fatal "game
; library failed to load" screen (games/shared LibraryCheck).
[configuration]

entry_symbol = "drift_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://.out/bin/libdrift.dylib"
macos.release = "res://.out/bin/libdrift.dylib"
windows.x86_64 = "res://.out/bin/drift.dll"
linux.x86_64 = "res://.out/bin/libdrift.so"

; Runtime libraries Godot loads with ours and the export ships next to it (Box3D, the EOS SDK; `uni build` copies
; this OS's into .out/bin).
[dependencies]

macos.debug = { "res://.out/bin/libbox3d.dylib": "Contents/Frameworks", "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
macos.release = { "res://.out/bin/libbox3d.dylib": "Contents/Frameworks", "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
windows.x86_64 = { "res://.out/bin/box3d.dll": "", "res://.out/bin/EOSSDK-Win64-Shipping.dll": "" }
linux.x86_64 = { "res://.out/bin/libbox3d.so": "" }
