; The game's GDExtension: the drift sim + unified (godot_host, view, netcode, devui), built from
; simulation/extension into the hidden artifacts folder (git-ignored). Without it a dev run uses the GDScript mock
; session; an export without it shows a fatal "game library failed to load" screen.
[configuration]

entry_symbol = "drift_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://.out/bin/libdrift.dylib"
macos.release = "res://.out/bin/libdrift.dylib"
windows.x86_64 = "res://.out/bin/drift.dll"
linux.x86_64 = "res://.out/bin/libdrift.so"

; Runtime libraries the export ships next to ours (EOS SDK; `dev.py game build` copies this OS's into .out/bin).
[dependencies]

macos.debug = { "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
macos.release = { "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
windows.x86_64 = { "res://.out/bin/EOSSDK-Win64-Shipping.dll": "" }
