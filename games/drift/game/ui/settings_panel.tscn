[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/settings_panel.gd" id="1_settings"]

[node name="SettingsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(520, 0)
script = ExtResource("1_settings")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Heading" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "Settings"

[node name="Grid" type="GridContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 12
columns = 2

[node name="Path" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Dim"
theme_override_font_sizes/font_size = 13
text = "Saved to user://settings.cfg"

[node name="Back" type="Button" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 8
theme_type_variation = &"PrimaryButton"
text = "Done"
