; The game's GDExtension: the survivor sim + unified (godot, view, netcode, devui), built from
; simulation/extension into the hidden artifacts folder (git-ignored). Nothing runs without it: a dev run or an
; export that lacks it shows a fatal "game library failed to load" screen.
[configuration]

entry_symbol = "survivor_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://.out/bin/libsurvivor.dylib"
macos.release = "res://.out/bin/libsurvivor.dylib"
windows.x86_64 = "res://.out/bin/survivor.dll"
linux.x86_64 = "res://.out/bin/libsurvivor.so"

; Runtime libraries Godot loads with ours and the export ships next to it, from what the extension links (Box3D,
; the EOS SDK): written by `uni build`, which also copies this OS's into .out/bin.
[dependencies]

macos.debug = { "res://.out/bin/libbox3d.dylib": "Contents/Frameworks", "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
macos.release = { "res://.out/bin/libbox3d.dylib": "Contents/Frameworks", "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
windows.x86_64 = { "res://.out/bin/box3d.dll": "", "res://.out/bin/EOSSDK-Win64-Shipping.dll": "" }
linux.x86_64 = { "res://.out/bin/libbox3d.so": "" }
