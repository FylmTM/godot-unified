; Engine configuration file. Hand-maintained (no editor in the loop): keep sections sorted and comments short.

config_version=5

[application]

config/name="friendslop"
config/description="Co-op physics sandbox on unified."
; "dev" in the repo: `uni release` stamps the tag's version into each release export.
config/version="dev"
run/main_scene="res://game/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://game/icon.svg"
boot_splash/bg_color=Color(0.55, 0.75, 0.95, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://game/audio/bus_layout.tres"

[autoload]

Settings="*res://game/autoload/settings.gd"
Sfx="*res://game/autoload/sfx.gd"
Game="*res://game/autoload/game.gd"

[debug]

; headless tool scripts (`uni tool`, the godot suite) run with the debugger on; a GDScript warning fails them.
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
move_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":13)]
}
move_right={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":14)]
}
move_forward={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":11)]
}
move_back={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":12)]
}
toggle_devui={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
grab={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
throw={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.95, 1)
