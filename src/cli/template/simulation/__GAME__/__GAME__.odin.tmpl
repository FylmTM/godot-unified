// __GAME__'s deterministic simulation, a unified sim package (unified/src/sim/SPEC.md): f32 only, no pointers or
// heap data in State, which is snapshotted with a memcpy. Each player moves a dot.
package __GAME__

import "unified:sim"

PLAYERS :: 4
TICK_HZ :: 64 // a power of two: dt is exact
// Metres a dot moves per tick at full input.
STEP :: f32(4) / f32(127 * TICK_HZ)

Input :: struct {
	dx:   i8, // -127 .. 127, right
	dy:   i8, // -127 .. 127, down
	_pad: [2]u8,
}

State :: struct {
	pos:    [PLAYERS][2]f32, // metres
	joined: [PLAYERS]bool,
}

// What lives outside the snapshotted state (physics, a level): nothing yet.
World :: struct {
	_unused: u8,
}

// Events (unified/src/sim/SPEC.md, Events): one plain struct each, the views get them by name.
Joined :: struct {
	player: u8,
}

Left :: struct {
	player: u8,
}

Event :: union {
	Joined,
	Left,
}

Game :: sim.Game(State, Input, World, PLAYERS)
Tick :: sim.Tick(State, Input, World, PLAYERS)

@(rodata)
GAME := Game {
	name = "__GAME__",
	version = "1",
	tick_hz = TICK_HZ,
	world_create = proc(seed: u64, _: []u8) -> ^World {return new(World)},
	world_destroy = proc(world: ^World) {free(world)},
	init = proc(state: ^State, world: ^World, seed: u64) {},
	tick = tick,
	events = Event,
}

tick :: proc(tick: ^Tick) {
	state := tick.state
	for player in 0 ..< PLAYERS {
		here := player in tick.inputs.present
		if here != state.joined[player] {
			state.joined[player] = here
			state.pos[player] = {f32(player), 0}
			if here {
				sim.emit(tick, Joined{player = u8(player)})
			} else {
				sim.emit(tick, Left{player = u8(player)})
			}
		}
		if here {
			input := tick.inputs.input[player]
			state.pos[player].x += f32(input.dx) * STEP
			state.pos[player].y += f32(input.dy) * STEP
		}
	}
}

// Scripted input for headless checks: a hash of (seed, player, tick / 16), so any tick can be asked for in any
// order.
scripted_input :: proc(seed: u64, player: int, tick: u32) -> Input {
	x := u32(seed) * 0x9E3779B1 ~ u32(player + 1) * 0x85EBCA77 ~ (tick / 16) * 0xC2B2AE3D
	x ~= x >> 15
	x *= 0x2C1B3C6D
	x ~= x >> 12
	return {dx = i8(x % 255) - 127, dy = i8((x >> 8) % 255) - 127}
}
