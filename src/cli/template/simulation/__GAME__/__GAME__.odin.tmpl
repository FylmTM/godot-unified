// __GAME__'s deterministic simulation, a unified sim package (unified/src/sim/SPEC.md): f32 only, no pointers or
// heap data in State, which is snapshotted with a memcpy. Each player moves a dot.
package __GAME__

import "unified:sim"

PLAYERS :: 4
TICK_HZ :: 64 // a power of two: dt is exact
DT :: f32(1) / TICK_HZ
SPEED :: f32(4) // metres per second at full input

Input :: struct {
	dx:   i8, // -127 .. 127, right
	dy:   i8, // -127 .. 127, down
	_pad: [2]u8,
}

State :: struct {
	pos:     [PLAYERS][2]f32, // metres
	present: sim.Players, // who is in the game (sim.presence_changes keeps it)
}

// What lives outside the snapshotted state (physics, a level): nothing yet.
World :: struct {
	_unused: u8,
}

// Events (unified/src/sim/SPEC.md, Events): one plain struct each; GDScript gets them as classes (EventJoined, EventLeft).
Joined :: struct {
	player: u8,
}

Left :: struct {
	player: u8,
}

Event :: union {
	Joined,
	Left,
}

Game :: sim.Game(State, Input, World, PLAYERS)
Tick :: sim.Tick(State, Input, World, PLAYERS)

@(rodata)
GAME := Game {
	name          = "__GAME__",
	version       = "1",
	tick_hz       = TICK_HZ,
	world_create  = world_create,
	world_destroy = world_destroy,
	init          = init,
	tick          = tick,
	events        = Event,
}

world_create :: proc(seed: u64, content: []u8) -> ^World {
	return new(World)
}

world_destroy :: proc(world: ^World) {
	free(world)
}

// The tick-0 state (the block is zeroed before): nothing more to set.
init :: proc(state: ^State, world: ^World, seed: u64) {}

tick :: proc(tick: ^Tick) {
	state := tick.state
	joined, left := sim.presence_changes(tick, &state.present)
	for player in joined {
		state.pos[player] = {f32(player), 0}
		sim.emit(tick, Joined{player = u8(player)})
	}
	for player in left do sim.emit(tick, Left{player = u8(player)})
	for player in state.present {
		input := tick.inputs.input[player]
		state.pos[player].x += f32(input.dx) / 127 * SPEED * DT
		state.pos[player].y += f32(input.dy) / 127 * SPEED * DT
	}
}

// Scripted input for headless checks: every player steers a random direction that changes every 16 ticks, the
// same for a seed, player and tick whatever order they are asked in.
scripted_input :: proc(seed: u64, player: int, tick: u32) -> Input {
	rng := sim.rng_seed(seed ~ u64(player + 1) << 32 ~ u64(tick / 16))
	return {dx = i8(sim.rng_below(&rng, 255)) - 127, dy = i8(sim.rng_below(&rng, 255)) - 127}
}
