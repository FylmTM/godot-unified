package __GAME__

import "unified:sim"

Input :: struct {
	dx:   i8, // -127 .. 127, right
	dy:   i8, // -127 .. 127, down
	_pad: [2]u8,
}

// A player's data (sim.Players): zeroed when someone new joins, kept while they are away.
Player_Data :: struct {
	position: [2]f32, // metres, on the ground plane
}

State :: struct {
	players: sim.Players(Player_Data, Input, PLAYERS), // the session's players: the library keeps who is here
}

