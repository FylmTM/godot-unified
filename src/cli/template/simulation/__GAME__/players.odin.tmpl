package __GAME__

import "unified:sim"

MOVE_SPEED :: f32(4) // metres per second at full input

// Players come and go between ticks (the library updates t.state.players first): someone new starts at their slot's
// spot; who comes back finds their player where they left it.
update_players_presence :: proc(t: ^Tick) {
	for player in t.joined {
		slot, _ := sim.player_slot(&t.state.players, player)
		sim.player_get(&t.state.players, player).position = {f32(slot), 0}
	}
}

move_players :: proc(t: ^Tick) {
	players := sim.iterate_present(&t.state.players)
	for data, player in sim.next(&players) {
		input := sim.input(t, player)
		data.position.x += f32(input.dx) / 127 * MOVE_SPEED * DT
		data.position.y += f32(input.dy) / 127 * MOVE_SPEED * DT
	}
}
