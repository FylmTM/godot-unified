package __GAME__

import "unified:sim"

// Scripted input for tests and headless checks: the player in `slot` steers a random direction that changes every
// 16 ticks, the same for a seed, slot and tick whatever order they are asked in.
scripted_input :: proc(seed: u64, slot: int, tick: u32, state: ^State) -> Input {
	bits := sim.script_bits(seed, slot, tick, 16)
	return {dx = i8(i32(bits % 255) - 127), dy = i8(i32((bits >> 8) % 255) - 127)}
}
