// __GAME__'s deterministic simulation, a unified sim package (unified's src/sim/SPEC.md): f32 only, no pointers or
// heap data in State, which is snapshotted with a memcpy.
package __GAME__

import "unified:sim"

PLAYERS :: 4 // input slots: who is in the session at once
TICK_HZ :: 64 // a power of two: t.dt is exact

Game :: sim.Game(State, Input, sim.No_World, Event, Cmd, PLAYERS)
Tick :: sim.Tick(Game)

@(rodata)
GAME := Game {
	name           = "__GAME__",
	version        = "1",
	tick_hz        = TICK_HZ,
	tick           = tick,
	scripted_input = scripted_input,
}

// Events (unified's src/sim/SPEC.md, Events): one plain struct each; GDScript gets them as classes. The library's
// join and leave are always listed (EventPlayerJoined, EventPlayerLeft).
Event :: union {
	sim.Event_Player_Joined,
	sim.Event_Player_Left,
}

// Commands (unified's src/sim/SPEC.md, Commands): one-shot actions a player sends, a union of plain structs
// (`Cmd :: union {Cmd_Ready}`); none yet.
Cmd :: sim.No_Commands


tick :: proc(t: ^Tick) {
	update_players_presence(t)
	move_players(t)
}
