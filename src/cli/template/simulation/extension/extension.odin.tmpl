// __GAME__'s GDExtension (game/__GAME__.gdextension -> .out/bin/): the sim run by unified's Godot integration
// (unified's src/godot/SPEC.md), with the glue: input.odin turns Godot's input into an Input, frame.odin the
// state into views.
package __GAME___extension

import "base:runtime"
import "unified:gdext/gdi"
import "unified:godot"

import g "../__GAME__"

GLUE := godot.Glue(g.Game, View, MultiView) {
	sample_input = sample_input,
	fill_frame   = fill_frame,
}

@(export, link_name = "__GAME___init")
__GAME___init :: proc "c" (
	get_proc_address: gdi.InterfaceGetProcAddress,
	library: gdi.ClassLibraryPtr,
	initialization: ^gdi.Initialization,
) -> gdi.Bool {
	context = runtime.default_context()
	return godot.init(&g.GAME, GLUE, get_proc_address, library, initialization)
}
