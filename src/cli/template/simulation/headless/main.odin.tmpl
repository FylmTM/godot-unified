// __GAME__'s headless binary: every mode of unified's src/headless/SPEC.md (offline runs, sync-tests, replays, the
// relay and clients, benchmarks) on the sim. `uni headless` runs it.
package main

import g "../__GAME__"
import "unified:headless"
import "unified:headless/modes"

HEADLESS := headless.Headless(g.State, g.Input, g.World, g.Event, g.Cmd, g.PLAYERS) {
	game = &g.GAME,
	scripted_input = proc(seed: u64, slot: int, tick: u32, state: ^g.State) -> g.Input {
		return g.scripted_input(seed, slot, tick)
	},
	bench = {what = "__GAME__ with 4 players", ticks = 600},
}

main :: proc() {
	modes.run(&HEADLESS)
}
