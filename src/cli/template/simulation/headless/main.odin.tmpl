// __GAME__'s headless binary: every mode of unified/src/headless/SPEC.md (offline runs, sync-tests, replays, the
// relay and clients, benchmarks) on the sim.
package main

import g "../__GAME__"
import "unified:headless"
import "unified:headless/modes"

HEADLESS := headless.Headless(g.State, g.Input, g.World, g.MAX_PLAYERS) {
	game = &g.GAME,
	script = proc(seed: u64, slot: int, t: u32, state: ^g.State) -> g.Input {return g.script(seed, slot, t)},
	bench = {what = "__GAME__ with 4 players, 8-tick rollback every tick", window = 8, ticks = 600},
}

main :: proc() {
	modes.run(&HEADLESS)
}
