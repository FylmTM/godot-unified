; Engine configuration file. Hand-maintained (no editor in the loop): keep sections sorted and comments short.

config_version=5

[application]

config/name="__GAME__"
; "dev" in the repo: a release build stamps its version into its export.
config/version="dev"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7")

[debug]

; Strict typing: untyped and unsafe code is an error, and tool runs fail on any warning. Tool scripts (game/tools,
; addons, generated .out) are left out: they compile before autoloads exist.
gdscript/warnings/directory_rules={
"res://.out": 0,
"res://addons": 0,
"res://game/tools": 0
}
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
