extends Node3D
## The game: a single player session; each player is a capsule (game/views/player.tscn) under this node, the
## session's view root. The arrow keys move.

@onready var session: UnifiedSession = %UnifiedSession


func _ready() -> void:
	if not session.is_running():  # headless checks (--autostart) have started one already
		session.start_single()
