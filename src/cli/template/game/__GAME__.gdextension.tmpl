; The game's GDExtension: the sim run by unified's Godot host, built from simulation/extension into the hidden
; artifacts folder (git-ignored) by `uni build` (and on demand by every command that runs the game).
[configuration]

entry_symbol = "__GAME___init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://.out/bin/lib__GAME__.dylib"
macos.release = "res://.out/bin/lib__GAME__.dylib"
windows.x86_64 = "res://.out/bin/__GAME__.dll"
linux.x86_64 = "res://.out/bin/lib__GAME__.so"
