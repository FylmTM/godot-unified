extends Node2D
## One player's dot: a scene view (kind `player`, its UnifiedView marker). The host sets its position every frame,
## interpolated between ticks; the marker says which player it shows.

@onready var view: UnifiedView = %UnifiedView


func _ready() -> void:
	queue_redraw()


func _draw() -> void:
	draw_circle(Vector2.ZERO, 12.0, Color.from_hsv(float(maxi(view.player, 0)) / 4.0, 0.6, 1.0))
