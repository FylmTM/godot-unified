extends Node3D
## One player's capsule: a scene view (kind `player`, its UnifiedView marker). The host sets its pose every frame,
## interpolated between ticks, and `color` from the sim's Player_View_Data (simulation/extension/frame.odin).

@onready var body: MeshInstance3D = %Body

var color: Color:
	set(value):
		color = value
		(body.material_override as StandardMaterial3D).albedo_color = value
