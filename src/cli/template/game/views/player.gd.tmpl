extends Node2D
## One player's dot: a scene view. The host sets its position every frame, interpolated between ticks.

var kind := &""
var entity := 0
var player := -1


func _ready() -> void:
	queue_redraw()


func _sim_update(_position: Vector2, _rotation: float, _alpha: float) -> void:
	pass


func _draw() -> void:
	draw_circle(Vector2.ZERO, 12.0, Color.from_hsv(float(maxi(player, 0)) / 4.0, 0.6, 1.0))
