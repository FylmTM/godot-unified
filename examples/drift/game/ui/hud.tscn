vertical_alignment = 1
script = ExtResource("2_banner")

[node name="Session" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("3_session")

[node name="Controls" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("4_controls")
