; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="horde"
config/description="Co-op 2D horde arena on unified: thousands of enemies, crowds as MultiMesh instances."
config/version="dev"
run/main_scene="res://game/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.075, 0.09, 1)
boot_splash/show_image=false
config/icon="res://game/icon.svg"

[audio]

buses/default_bus_layout="res://game/app/bus_layout.tres"

[autoload]

LibraryCheck="*res://game/app/library_check.gd"
Settings="*res://game/app/settings.gd"
Sfx="*res://game/app/sfx.gd"
Game="*res://game/app/game.gd"

[debug]

gdscript/warnings/directory_rules={
"res://.out": 0,
"res://game/tools": 0
}
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

