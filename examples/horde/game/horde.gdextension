; The game's GDExtension: the horde sim + unified (godot, view, netcode, devui), built from simulation/extension into
; the hidden artifacts folder (git-ignored). Without it the game shows a fatal "game library failed to load" screen
; (game/app/library_check.gd).
[configuration]

entry_symbol = "horde_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://.out/bin/libhorde.dylib"
macos.release = "res://.out/bin/libhorde.dylib"
windows.x86_64 = "res://.out/bin/horde.dll"
linux.x86_64 = "res://.out/bin/libhorde.so"

; Runtime libraries Godot loads with ours and the export ships next to it, from what the extension links (Box3D,
; the EOS SDK): written by `uni build`, which also copies this OS's into .out/bin.
[dependencies]

macos.debug = { "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
macos.release = { "res://.out/bin/libEOSSDK-Mac-Shipping.dylib": "Contents/Frameworks" }
windows.x86_64 = { "res://.out/bin/EOSSDK-Win64-Shipping.dll": "" }
