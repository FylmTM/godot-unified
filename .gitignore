# Build outputs and local scratch, anywhere
.DS_Store
.tmp/
target/
out/
build/
obj/
bin/
.zig-cache/
zig-out/
.godot/

# Box3D sources and builds are fetched by tools/box3d.py
/third_party/box3d/

# CI toolchain downloads (tools/ci.py odin)
/.toolchains/

# Reference input logs (a global *.log ignore would otherwise drop them)
!/testdata/**/ref.log

# Generated Godot bindings (python tools/dev.py gen)
*.gen.odin

# Godot build outputs (game libraries, exports) and import caches
.uni/

# Dear ImGui sources and builds are fetched by tools/imgui.py
/third_party/imgui/

# EOS SDK (headers + shipping libraries), staged by tools/eos.py
/third_party/eos/

# Binaries odin test/build drop at the repo root
/netcode
/survivor
/*.bin
