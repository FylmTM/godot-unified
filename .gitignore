# Generated output, anywhere (src/cli/SPEC.md): the CLI, builds, downloads, Godot's import caches. Safe to delete.
.out/
.godot/
.DS_Store

# This checkout's UNIFIED_* settings (src/cli/SPEC.md, Local settings): never committed.
.env

# Old per-checkout toolchain folder (no longer written)
/.toolchains/

# Reference input logs (a global *.log ignore would otherwise drop them)
!/games/*/simulation/tests/testdata/ref.log
!/tests/scenarios/testdata/ref.log

# Generated Godot bindings (from the API dump, when stale)
*.gen.odin

# Older checkouts staged the EOS SDK here; Epic's licence keeps it out of the repo (docs/EOS.md)
/third_party/
