#!/bin/sh
# uni, the unified CLI (src/cli/README.md, Bootstrap and self-rebuild): runs the binary .out/cli/current names, building one first when
# there is none. Odin is always the release pins.cfg pins, downloaded once into ~/.cache/unified/odin/<tag> (checked
# against its SHA-256) and put first on PATH.
case "$0" in
*/*) root=${0%/*} ;;
*) root=. ;;
esac
cli="$root/.out/cli"
pins="$root/pins.cfg"
[ -f "$pins" ] || pins="$root/unified/pins.cfg" # a game repo: unified is its submodule
exe=
[ "$OS" = Windows_NT ] && exe=.exe # Git Bash on Windows: odin wants the extension

die() {
	echo "uni: $*" >&2
	exit 1
}

# The pinned release, downloaded, checked and unpacked into $odin.
download() {
	case $(uname -s)-$(uname -m) in
	Linux-x86_64) plat=linux_x64 asset=odin-linux-amd64-$tag.tar.gz ;;
	Linux-aarch64 | Linux-arm64) plat=linux_arm64 asset=odin-linux-arm64-$tag.tar.gz ;;
	Darwin-arm64) plat=macos_arm64 asset=odin-macos-arm64-$tag.tar.gz ;;
	*_NT*-x86_64) plat=windows_x64 asset=odin-windows-amd64-$tag.zip ;;
	*) die "no Odin release for $(uname -sm) (pins.cfg pins linux x64 and arm64, macOS arm64, Windows x64)" ;;
	esac
	case "$shas " in
	*" sha256_$plat="*) sha=${shas#* sha256_$plat=}; sha=${sha%% *} ;;
	*) die "$pins: no [odin] sha256_$plat" ;;
	esac
	dl="$odin.tmp-$$"
	rm -rf "$dl" && mkdir -p "$dl" || die "cannot create $dl"
	echo "uni: downloading Odin $tag (pins.cfg) once, into $odin" >&2
	curl -fL --retry 3 --progress-bar -o "$dl/$asset" "https://github.com/odin-lang/Odin/releases/download/$tag/$asset" ||
		{ rm -rf "$dl"; die "cannot download $asset"; }
	if command -v sha256sum > /dev/null 2>&1; then got=$(sha256sum < "$dl/$asset"); else got=$(shasum -a 256 < "$dl/$asset"); fi
	got=${got%% *}
	[ "$got" = "$sha" ] || { rm -rf "$dl"; die "$asset: SHA-256 $got, pinned $sha"; }
	case $asset in
	*.zip) unzip -q "$dl/$asset" -d "$dl" ;;
	*) tar -xzf "$dl/$asset" -C "$dl" ;;
	esac || { rm -rf "$dl"; die "cannot unpack $asset"; }
	for d in "$dl"/*/; do # the archive's one top folder
		[ -f "$d/odin$exe" ] && [ ! -e "$odin" ] && mv "${d%/}" "$odin"
	done
	rm -rf "$dl"
	[ -f "$odin/odin$exe" ] || die "$asset holds no odin$exe"
}

# The [odin] pins, read without starting a process; the loop stops at the next section.
tag= shas= s=
while read -r k _ v; do
	case $k in
	\[*)
		[ "$s" = "[odin]" ] && break
		s=$k
		;;
	tag | sha256_*)
		[ "$s" = "[odin]" ] || continue
		v=${v#\"}; v=${v%%\"*}
		case $k in
		tag) tag=$v ;;
		*) shas="$shas $k=$v" ;;
		esac
		;;
	esac
done < "$pins"
[ -n "$tag" ] || die "$pins: no [odin] tag"
if [ "$OS" = Windows_NT ]; then
	odin="$HOME/AppData/Local/unified/odin/$tag" # where uni.cmd puts it (%LOCALAPPDATA%)
else
	odin="${XDG_CACHE_HOME:-$HOME/.cache}/unified/odin/$tag"
fi
[ -f "$odin/odin$exe" ] || download
PATH="$odin:$PATH"
export PATH

if [ -f "$cli/current" ]; then
	read -r name < "$cli/current"
	[ -x "$cli/$name" ] && exec "$cli/$name" "$@"
fi
src="$root/src"
[ -d "$root/unified/src/cli" ] && src="$root/unified/src"
mkdir -p "$cli"
odin build "$root/tools" "-collection:unified=$src" -o:minimal "-out:$cli/uni-bootstrap$exe" \
	-export-dependencies:json "-export-dependencies-file:$cli/uni-bootstrap.deps.json" || exit 1
exec "$cli/uni-bootstrap$exe" "$@"
