#!/bin/sh
# uni, the unified CLI (src/cli/SPEC.md): runs the binary .out/cli/current names. Only when there is none yet, it builds
# one with the odin on PATH; from then on the binary keeps itself current.
case "$0" in
*/*) root=${0%/*} ;;
*) root=. ;;
esac
cli="$root/.out/cli"
if [ -f "$cli/current" ]; then
	read -r name < "$cli/current"
	[ -x "$cli/$name" ] && exec "$cli/$name" "$@"
fi
if ! command -v odin > /dev/null 2>&1; then
	echo "uni: odin is not on PATH: install the Odin release pinned in pins.cfg (README.md, Requirements)" >&2
	exit 1
fi
src="$root/src"
[ -d "$root/unified/src/cli" ] && src="$root/unified/src"
exe=
[ "$OS" = Windows_NT ] && exe=.exe # Git Bash on Windows: odin wants the extension
mkdir -p "$cli"
odin build "$root/tools" "-collection:unified=$src" -o:minimal "-out:$cli/uni-bootstrap$exe" \
	-export-dependencies:json "-export-dependencies-file:$cli/uni-bootstrap.deps.json" || exit 1
exec "$cli/uni-bootstrap$exe" "$@"
