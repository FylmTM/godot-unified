diff -ruN a/src/world_state.c b/src/world_state.c
--- a/src/world_state.c
+++ b/src/world_state.c
@@ -0,0 +1,126 @@
+// SPDX-FileCopyrightText: 2026 Erin Catto
+// SPDX-License-Identifier: MIT
+
+// FORK: public world save/restore for rollback, a thin wrapper over the internal
+// snapshot serializer that the recording player uses for keyframes (world_snapshot.c).
+// Save = b3SerializeWorld into a reusable buffer, interning shape geometry into a registry
+// owned by the cache. Restore = b3DeserializeIntoShell in place over the live world, exactly
+// like b3RecPlayerRestoreKeyframe, with a reader whose registry slots mirror the cache.
+
+#include "world_snapshot.h"
+
+#include "core.h"
+#include "physics_world.h"
+
+#include "box3d/box3d.h"
+
+#include <string.h>
+
+struct b3WorldStateCache
+{
+	// Only the geometry registry of this recording is used; its op buffer stays empty.
+	b3Recording* registry;
+
+	// Reader view of the registry for b3DeserializeIntoShell. Entries are append only and each
+	// owns its bytes, so the slots only need extending when the registry grows.
+	b3RecReader reader;
+	int slotCapacity;
+};
+
+struct b3WorldState
+{
+	b3RecBuffer buffer;
+};
+
+b3WorldStateCache* b3CreateWorldStateCache( void )
+{
+	b3WorldStateCache* cache = b3Alloc( sizeof( b3WorldStateCache ) );
+	memset( cache, 0, sizeof( b3WorldStateCache ) );
+	cache->registry = b3CreateRecording( 64 );
+	return cache;
+}
+
+void b3DestroyWorldStateCache( b3WorldStateCache* cache )
+{
+	if ( cache == NULL )
+	{
+		return;
+	}
+	if ( cache->reader.slots != NULL )
+	{
+		b3Free( cache->reader.slots, (size_t)cache->slotCapacity * sizeof( b3RegistrySlot ) );
+	}
+	b3DestroyRecording( cache->registry );
+	b3Free( cache, sizeof( b3WorldStateCache ) );
+}
+
+b3WorldState* b3CreateWorldState( void )
+{
+	b3WorldState* state = b3Alloc( sizeof( b3WorldState ) );
+	memset( state, 0, sizeof( b3WorldState ) );
+	return state;
+}
+
+void b3DestroyWorldState( b3WorldState* state )
+{
+	if ( state == NULL )
+	{
+		return;
+	}
+	b3RecBufFree( &state->buffer );
+	b3Free( state, sizeof( b3WorldState ) );
+}
+
+const uint8_t* b3WorldState_GetData( const b3WorldState* state )
+{
+	return state->buffer.data;
+}
+
+int b3WorldState_GetSize( const b3WorldState* state )
+{
+	return state->buffer.size;
+}
+
+int b3World_SaveState( b3WorldId worldId, b3WorldStateCache* cache, b3WorldState* state )
+{
+	b3World* world = b3GetWorldFromId( worldId );
+	B3_ASSERT( world->locked == false );
+	if ( world->locked )
+	{
+		return 0;
+	}
+
+	// Reuse the buffer capacity: a steady-state save does not allocate.
+	state->buffer.size = 0;
+	state->buffer.countOnly = false;
+	return b3SerializeWorld( world, &state->buffer, cache->registry );
+}
+
+bool b3World_RestoreState( b3WorldId worldId, b3WorldStateCache* cache, const b3WorldState* state )
+{
+	b3World* world = b3GetWorldFromId( worldId );
+	B3_ASSERT( world->locked == false );
+	if ( world->locked || state->buffer.size == 0 )
+	{
+		return false;
+	}
+
+	// Mirror any registry entries added since the last restore into reader slots (id == index).
+	b3GeometryRegistry* reg = &cache->registry->registry;
+	int count = reg->entries.count;
+	if ( count > cache->slotCapacity )
+	{
+		int newCap = count < 8 ? 8 : 2 * count;
+		cache->reader.slots = b3GrowAlloc( cache->reader.slots, cache->slotCapacity * (int)sizeof( b3RegistrySlot ),
+										   newCap * (int)sizeof( b3RegistrySlot ) );
+		cache->slotCapacity = newCap;
+	}
+	for ( int i = cache->reader.slotCount; i < count; ++i )
+	{
+		const b3GeometryEntry* entry = reg->entries.data + i;
+		cache->reader.slots[i] = (b3RegistrySlot){ entry->kind, entry->byteCount, entry->bytes };
+	}
+	cache->reader.slotCount = count;
+
+	return b3DeserializeIntoShell( state->buffer.data, state->buffer.size, world, &cache->reader );
+}
