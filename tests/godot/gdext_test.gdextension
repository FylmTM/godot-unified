; The binding test extension (tests/godot/ext), built by `uni test --suite godot-bindings`.
[configuration]

entry_symbol = "gdext_test_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://.out/bin/libgdext_test.dylib"
macos.release = "res://.out/bin/libgdext_test.dylib"
linux.x86_64 = "res://.out/bin/libgdext_test.so"
windows.x86_64 = "res://.out/bin/gdext_test.dll"
