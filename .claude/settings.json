{
  "permissions": {
    "allow": [
      "Bash(./uni drive *)",
      "Bash(./uni.cmd drive *)",
      "Bash(uni.cmd drive *)",
      "PowerShell(./uni.cmd drive *)",
      "PowerShell(.\\uni.cmd drive *)",
      "PowerShell(uni.cmd drive *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/uni\" fmt --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
